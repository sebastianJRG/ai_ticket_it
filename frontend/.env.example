# URL del backend (puerto 3000). Reiniciar Expo con `npx expo start -c` tras cambiarla.
# - Web / simulador iOS: http://localhost:3000
# - Emulador Android:    http://10.0.2.2:3000 (es el valor por defecto en Android)
# - Celular físico:      IP LAN del PC, ej.: http://192.168.1.50:3000
#   (el firewall del PC debe permitir el puerto 3000)
# Para Expo web, arrancar el backend con: FRONTEND_URL=http://localhost:8081 npm run dev:backend
EXPO_PUBLIC_API_URL=http://localhost:3000
