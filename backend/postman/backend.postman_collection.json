    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombreUsuario\": \"{{nombreUsuario}}\",\"contrasenia\": \"{{password}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "script": {
              "exec": "// Extraer tokens del cuerpo de respuesta y guardarlos en variables de entorno\\nconst jsonData = pm.response.json();\\nif (jsonData.accessToken) {\\n  pm.variables.set(\"accessToken\", jsonData.accessToken);\\n}\\nif (jsonData.refreshToken) {\\n  pm.variables.set(\"refreshToken\", jsonData.refreshToken);\\n}\\n// Mostrar tokens en la consola para debugging\\nconsole.log(\"Tokens guardados - accessToken:\", pm.variables.get(\"accessToken\") ? \"OK\" : \"FAIL\", \"refreshToken:\", pm.variables.get(\"refreshToken\") ? \"OK\" : \"FAIL\")",
              "exposure": "examples"
            }
          },
          "response": []
        },
        {
          "name": "Renovar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "refresh"
              ]
            },
            "script": {
              "exec": "// Extraer nuevos tokens del cuerpo de respuesta y guardarlos\\nconst jsonData = pm.response.json();\\nif (jsonData.accessToken) {\\n  pm.variables.set(\"accessToken\", jsonData.accessToken);\\n}\\nif (jsonData.refreshToken) {\\n  pm.variables.set(\"refreshToken\", jsonData.refreshToken);\\n}\\n// Mostrar tokens en la consola para debugging\\nconsole.log(\"Tokens renovados - accessToken:\", pm.variables.get(\"accessToken\") ? \"OK\" : \"FAIL\", \"refreshToken:\", pm.variables.get(\"refreshToken\") ? \"OK\" : \"FAIL\")",
              "exposure": "examples"
            }
          },
          "response": []
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "script": {
              "exec": "// Después de cerrar sesión, limpiar los tokens\\npm.variables.set(\"accessToken\", \"\");\\npm.variables.set(\"refreshToken\", \"\");\\nconsole.log(\"Sesión cerrada y tokens limpiados\")\\n// Scripts pre-request para categorías y eventos se añaden automáticamente\\n// if (!\\\"{{nombreCategoria}}\\\".includes(\\\"{{}}\\\")) { pm.variables.set(\\\"nombreCategoria\\\", \\\"Categoria \\' + (pm.environment.get(\\\"USER_ROLE\\\") or \\\"ORGANIZADOR\\\") + \\\'\\') ; }\\n// if (!\\\"{{descripcionCategoria}}\\\".includes(\\\"{{}}\\\")) { pm.variables.set(\\\"descripcionCategoria\\\", \\\"Descripción automática para \\' + (pm.environment.get(\\\"USER_ROLE\\\") or \\\"ORGANIZADOR\\\") + \\\'\\') ; }',
              "exposure": "examples"
            }
          },
          "response": []
        }
      ]
    },
