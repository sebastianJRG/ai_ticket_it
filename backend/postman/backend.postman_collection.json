	"item": [
		{
			"name": "Usuarios",
			"item": [
				{
					"name": "Crear usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"apellido\": \"{{apellido}}\",\n  \"nombreUsuario\": \"{{username}}\",\n  \"contrasenia\": \"{{password}}\",\n  \"rol\": \"{{rol}}\"\n}"
						},
						"url": {
							"raw": "{{\n  base_url\n}}/usuarios",
							"host": ["{{\n  base_url\n}}"],
							"path": ["usuarios"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Iniciar sesión",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreUsuario\": \"{{nombreUsuario}}\",\n  \"contrasenia\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{\n  base_url\n}}/login",
							"host": ["{{\n  base_url\n}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "Renovar token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{\n  base_url\n}}/refresh",
							"host": ["{{\n  base_url\n}}"],
							"path": ["refresh"]
						}
					}
				},
				{
					"name": "Cerrar sesión",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{\n  base_url\n}}/logout",
							"host": ["{{\n  base_url\n}}"],
							"path": ["logout"]
						}
					}
				}
			]
		}
