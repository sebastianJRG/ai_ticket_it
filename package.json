{
	"name": "ai_ticket_it_v2",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"backend",
		"frontend"
	],
	"scripts": {
		"format": "prettier --write \"**/*.{js,jsx,json}\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"dev:backend": "npm run dev --workspace=backend",
		"dev:backend:seed": "npm run dev:seed --workspace=backend",
		"dev:frontend": "npm run start --workspace=frontend",
		"test:backend": "npm run test --workspace=backend",
		"test:frontend": "npm run test --workspace=frontend"
	},
	"devDependencies": {
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^65.5.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10"
	}
}
